# ─────────────────────────────────────────────────────────────────────────────
# Hospital Implant Expiration Tracker — environment variables
#
# Inventory is saved to a LOCAL EXCEL FILE in the browser (no cloud account for
# data), so the only server-side secret is the Claude Vision API key.
#
# This is OPTIONAL: the key can also be entered in the in-app Settings page.
# Setting it here (as a Vercel Environment Variable) is recommended for a shared
# deployment so technicians never handle the API key.
# ─────────────────────────────────────────────────────────────────────────────

# --- Claude Vision (Anthropic) ---------------------------------------------
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the vision model (defaults to claude-haiku-4-5-20251001,
# the cheapest option; the in-app Settings → Model dropdown can also change it)
# CLAUDE_VISION_MODEL=claude-haiku-4-5-20251001

# --- App login (gates the page AND the API) --------------------------------
# Defaults work out of the box, but SET THESE in Vercel for real security —
# otherwise the default password is visible in the source code.
APP_USERNAME=mmtracker
APP_PASSWORD=Directorlevelshiz
# A random secret used to sign the login cookie. Set to any long random string.
AUTH_SECRET=change-me-to-a-long-random-string
