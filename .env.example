# ─────────────────────────────────────────────────────────────────────────────
# Hospital Implant Expiration Tracker — environment variables
#
# These are OPTIONAL. The app can also be configured entirely from the in-app
# Settings page (keys stored in the browser's localStorage). Setting them here
# as Vercel Environment Variables is the recommended approach for a shared,
# locked-down deployment so individual technicians never handle API keys.
# ─────────────────────────────────────────────────────────────────────────────

# --- Claude Vision (Anthropic) ---------------------------------------------
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the vision model (defaults to a current Claude model)
# CLAUDE_VISION_MODEL=claude-opus-4-8

# --- Google Sheets (Service Account) ---------------------------------------
# Create a Google Cloud service account with the Sheets API enabled, then
# SHARE your Google Sheet with the service account's client_email (Editor).
#
# Provide the service account credentials as a single-line JSON string OR as
# base64. The whole JSON from the downloaded key file goes here.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"tracker@your-project.iam.gserviceaccount.com","client_id":"..."}

# The target spreadsheet ID (the long id in the sheet URL between /d/ and /edit)
GOOGLE_SHEET_ID=

# Optional: the tab/sheet name to append to (defaults to "Inventory")
# GOOGLE_SHEET_TAB=Inventory
