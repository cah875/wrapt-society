{
  "expo": {
    "name": "PeptideVault",
    "slug": "peptidevault",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "peptidevault",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1117",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F1117"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.peptidevault.app"
    },
    "android": {
      "package": "com.peptidevault.app"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#00D4AA"
        }
      ]
    ]
  }
}
